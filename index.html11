<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Speak English With Confidence</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        body {
            background-color: #ffffff;
            color: #251721;
            line-height: 1.6;
        }

        /* Hero Section */
        .hero-section {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px 24px;
            gap: 48px;
            background: #ffffff;
        }

        .hero-content {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 22.8px;
        }

        .heading-container {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .heading-main {
            font-family: 'Montserrat', serif;
            font-size: 48px;
            font-weight: 700;
            line-height: 1.2;
            color: #251721;
            margin: 0;
            letter-spacing: -0.5px;
        }

        .heading-accent {
            color: #e600d1;
            display: inline;
        }

        .description-container {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .description-text {
            font-family: 'Inter', sans-serif;
            font-size: 18px;
            font-weight: 400;
            line-height: 1.6;
            color: #56404f;
            margin: 0;
        }

        /* Buttons Container */
        .buttons-container {
            display: flex;
            gap: 16px;
            margin-top: 17.2px;
            flex-wrap: wrap;
        }

        .btn {
            height: 64px;
            padding: 25.5px 32px;
            border-radius: 4px;
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            cursor: pointer;
            border: none;
            transition: all 0.3s ease;
            white-space: nowrap;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.03);
        }

        .btn-primary {
            background-color: #e600d1;
            color: #ffffff;
        }

        .btn-primary:hover {
            background-color: #cc00b8;
            transform: translateY(-2px);
            box-shadow: 0px 8px 20px rgba(230, 0, 209, 0.2);
        }

        .btn-secondary {
            background-color: transparent;
            color: #e600d1;
            border: 2px solid #e600d1;
        }

        .btn-secondary:hover {
            background-color: #e600d1;
            color: #ffffff;
            transform: translateY(-2px);
        }

        /* Quote Section */
        .quote-container {
            margin-top: 24px;
            padding-left: 20px;
            border-left: 4px solid #e600d1;
            display: flex;
            flex-direction: column;
        }

        .quote-text {
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-style: italic;
            color: #897081;
            line-height: 1.5;
            margin: 0;
        }

        /* Hero Image Section */
        .hero-image-container {
            flex: 1;
            min-width: 0;
            background-color: #f4dcea;
            border-radius: 32px;
            height: 600px;
            overflow: hidden;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .professional-portrait {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
        }

        /* Floating Cards */
        .floating-card {
            position: absolute;
            background: white;
            border-radius: 4px;
            padding: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.03);
            font-size: 12px;
            font-weight: 600;
            color: #251721;
            letter-spacing: 0.6px;
        }

        .floating-card.top-left {
            top: 32px;
            left: -20px;
        }

        .floating-card.bottom-right {
            bottom: 64px;
            right: -20px;
        }

        .card-icon {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
        }

        /* Form Section */
        .form-section {
            background: linear-gradient(135deg, #f9f5f7 0%, #fef0f5 100%);
            padding: 80px 24px;
            text-align: center;
        }

        .form-container {
            max-width: 500px;
            margin: 0 auto;
            background: white;
            padding: 48px;
            border-radius: 16px;
            box-shadow: 0px 10px 40px rgba(0, 0, 0, 0.08);
        }

        .form-title {
            font-family: 'Montserrat', serif;
            font-size: 36px;
            font-weight: 700;
            color: #251721;
            margin-bottom: 12px;
            line-height: 1.2;
        }

        .form-subtitle {
            font-size: 16px;
            color: #56404f;
            margin-bottom: 36px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            margin-bottom: 24px;
            text-align: left;
        }

        .form-label {
            font-size: 14px;
            font-weight: 600;
            color: #251721;
            margin-bottom: 8px;
            letter-spacing: 0.3px;
        }

        .form-input {
            padding: 14px 16px;
            font-size: 16px;
            border: 2px solid #e8dce5;
            border-radius: 8px;
            font-family: 'Inter', sans-serif;
            transition: all 0.3s ease;
            color: #251721;
        }

        .form-input:focus {
            outline: none;
            border-color: #e600d1;
            box-shadow: 0 0 0 3px rgba(230, 0, 209, 0.1);
        }

        .form-input::placeholder {
            color: #a89095;
        }

        .form-submit {
            width: 100%;
            height: 56px;
            background-color: #e600d1;
            color: white;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 0.6px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Inter', sans-serif;
            text-transform: uppercase;
            margin-top: 12px;
        }

        .form-submit:hover {
            background-color: #cc00b8;
            transform: translateY(-2px);
            box-shadow: 0px 8px 20px rgba(230, 0, 209, 0.2);
        }

        .form-submit:active {
            transform: translateY(0);
        }

        .form-submit:disabled {
            background-color: #d4a8cc;
            cursor: not-allowed;
            transform: none;
        }

        /* Success/Error Messages */
        .message {
            margin-top: 16px;
            padding: 14px 16px;
            border-radius: 8px;
            font-size: 14px;
            text-align: center;
            display: none;
        }

        .message.success {
            background-color: #d4f1d4;
            color: #2d6b2d;
            border-left: 4px solid #4caf50;
        }

        .message.error {
            background-color: #fdd4d4;
            color: #9b2c2c;
            border-left: 4px solid #f44336;
        }

        .message.show {
            display: block;
            animation: slideIn 0.3s ease;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Responsive Design */
        @media (max-width: 1024px) {
            .hero-section {
                flex-direction: column;
                gap: 32px;
                padding: 40px 24px;
                min-height: auto;
            }

            .hero-image-container {
                height: 400px;
                width: 100%;
            }

            .heading-main {
                font-size: 36px;
            }

            .buttons-container {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }
        }

        @media (max-width: 640px) {
            .hero-section {
                padding: 24px 16px;
                gap: 24px;
            }

            .heading-main {
                font-size: 28px;
            }

            .description-text {
                font-size: 16px;
            }

            .hero-image-container {
                height: 300px;
                border-radius: 16px;
            }

            .form-container {
                padding: 32px 20px;
            }

            .form-title {
                font-size: 28px;
            }

            .form-section {
                padding: 48px 16px;
            }

            .floating-card {
                font-size: 11px;
                padding: 8px;
            }

            .floating-card.top-left {
                top: 16px;
                left: -12px;
            }

            .floating-card.bottom-right {
                bottom: 32px;
                right: -12px;
            }
        }

        /* Loading state */
        .loading {
            position: relative;
        }

        .loading::after {
            content: '';
            position: absolute;
            top: 50%;
            right: 16px;
            width: 16px;
            height: 16px;
            margin-top: -8px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-top: 2px solid white;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-content">
            <div class="heading-container">
                <h1 class="heading-main">Speak English With Confidence. <span class="heading-accent">Become the Person People Listen To.</span></h1>
            </div>

            <div class="description-container">
                <p class="description-text">Break free from hesitation. Build the expressiveness and confidence to command every conversation, professional or personal.</p>
            </div>

            <div class="buttons-container">
                <button class="btn btn-primary">Start Your Confidence Journey</button>
                <button class="btn btn-secondary">Book a Free Consultation</button>
            </div>

            <div class="quote-container">
                <p class="quote-text">"You don't need perfect English. You need the confidence to use the English you already know."</p>
            </div>
        </div>

        <div class="hero-image-container">
            <img src="https://www.figma.com/api/mcp/asset/0705367a-adbb-4584-845a-52782cc27366.png" alt="Professional Portrait" class="professional-portrait">
            
            <div class="floating-card top-left">
                <svg class="card-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="10" cy="10" r="8" fill="#e600d1"/>
                    <path d="M10 5v5h5" stroke="white" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <span>Confidence Coaching</span>
            </div>

            <div class="floating-card bottom-right">
                <svg class="card-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2 10c0 4.418 3.582 8 8 8s8-3.582 8-8-3.582-8-8-8-8 3.582-8 8z" fill="#e600d1"/>
                    <path d="M10 6v4l3 2" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Spoken English</span>
            </div>
        </div>
    </section>

    <!-- Form Section -->
    <section class="form-section">
        <div class="form-container">
            <h2 class="form-title">Get Started Today</h2>
            <p class="form-subtitle">Join hundreds who've transformed their English confidence</p>

            <form id="confidence-form">
                <div class="form-group">
                    <label for="name" class="form-label">Full Name</label>
                    <input 
                        type="text" 
                        id="name" 
                        name="name" 
                        class="form-input" 
                        placeholder="Your full name"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="email" class="form-label">Email Address</label>
                    <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        class="form-input" 
                        placeholder="your@email.com"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="phone" class="form-label">Phone Number</label>
                    <input 
                        type="tel" 
                        id="phone" 
                        name="phone" 
                        class="form-input" 
                        placeholder="+1 (555) 000-0000"
                        required
                    >
                </div>

                <button type="submit" class="form-submit">Submit</button>

                <div id="message" class="message"></div>
            </form>
        </div>
    </section>

    <script>
        // Configuration
        const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzee83VUDaudu6jLbbKSeIcQpwSkuKenfG_Z0fZQLh4Ks1kri0llSfyVF5xLicgMCTS/exec';

        // Get form elements
        const form = document.getElementById('confidence-form');
        const submitBtn = form.querySelector('.form-submit');
        const messageDiv = document.getElementById('message');

        // Handle form submission
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            // Get form values
            const name = document.getElementById('name').value.trim();
            const email = document.getElementById('email').value.trim();
            const phone = document.getElementById('phone').value.trim();

            // Validation
            if (!name || !email || !phone) {
                showError('Please fill in all fields');
                return;
            }

            if (!validateEmail(email)) {
                showError('Please enter a valid email address');
                return;
            }

            // Submit form
            submitForm(name, email, phone);
        });

        function submitForm(name, email, phone) {
            // Disable button and show loading state
            submitBtn.disabled = true;
            submitBtn.classList.add('loading');
            hideMessage();

            // Build URL with query parameters (GET request)
            const url = SCRIPT_URL + '?' + new URLSearchParams({
                name: name,
                email: email,
                phone: phone
            }).toString();

            // Make fetch request with GET and no-cors mode
            fetch(url, {
                method: 'GET',
                mode: 'no-cors'
            })
            .then(() => {
                // Success - don't check response due to no-cors
                showSuccess('Thank you! Your submission has been received. We\'ll be in touch soon.');
                form.reset();
                submitBtn.disabled = false;
                submitBtn.classList.remove('loading');
            })
            .catch(() => {
                // Error
                showError('Something went wrong. Please try again.');
                submitBtn.disabled = false;
                submitBtn.classList.remove('loading');
            });
        }

        function validateEmail(email) {
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            return emailRegex.test(email);
        }

        function showSuccess(message) {
            messageDiv.textContent = message;
            messageDiv.className = 'message success show';
            messageDiv.style.display = 'block';
        }

        function showError(message) {
            messageDiv.textContent = message;
            messageDiv.className = 'message error show';
            messageDiv.style.display = 'block';
        }

        function hideMessage() {
            messageDiv.classList.remove('show');
            setTimeout(() => {
                messageDiv.style.display = 'none';
            }, 300);
        }

        // Add smooth scroll behavior
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });
    </script>
</body>
</html>
